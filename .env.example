# ---------------------------------------------------------------
# LLM provider: "gemini" (free key) or "openai" (paid key)
# ---------------------------------------------------------------
LLM_PROVIDER=gemini

# Google Gemini - free key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-api-key-here
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# OpenAI - only needed if LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# RAG settings
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=4

# Storage (relative paths are resolved from the backend/ folder)
DATA_DIR=./data
CHROMA_COLLECTION=dataops_docs

# Frontend URL allowed to call the API (CORS)
FRONTEND_ORIGIN=http://localhost:5173
